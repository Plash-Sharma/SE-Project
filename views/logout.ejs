<%- include('partials/head') %>

<header class="home-header">
    <h1>Logout</h1>
    <h2>Are you sure you want to leave?</h2>
</header>

<main class="logout-main">
    <div class="confirm-container">
        <div class="confirm-icon glow-border">
            <i data-lucide="log-out" width="36" height="36" class="lucide-icon" style="color: var(--highlight-text);"></i>
        </div>
        <p class="confirm-heading">Logout</p>
        <p class="confirm-text">You will be redirected to the homepage after logging out.</p>
        <div class="confirm-actions">
            <a href="/" class="cancel-btn" id="cancel-logout">Cancel</a>
            <form action="/logout" method="POST" style="display:inline;">
                <button type="submit" class="danger-btn" id="confirm-logout">Logout</button>
            </form>
        </div>
    </div>
</main>
