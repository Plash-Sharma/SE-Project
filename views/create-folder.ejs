<%- include('partials/head') %>

<header class="home-header">
    <h1>Create Folder</h1>
    <h2>Organize your files</h2>
</header>

<main class="folder-main">
    <%- include('partials/inline-errors') %>

    <form action="/create-folder" method="POST" class="app-form" id="create-folder-form">
        <div class="form-row">
            <label for="name">Folder Name</label>
            <input type="text" id="name" name="name" placeholder="e.g. Vacation Photos" required maxlength="100">
        </div>
        <div class="form-row">
            <label for="description">Description <span class="hint">(optional)</span></label>
            <input type="text" id="description" name="description" placeholder="Brief description" maxlength="500">
        </div>
        <!-- FOLDER VISIBILITY SELECTOR COMMENTED OUT
        <%- include('partials/visibility', { visibilities, selectedVisibility: 'private' }) %>
        -->
        <!-- Default visibility sent as hidden field -->
        <input type="hidden" name="visibility" value="private">
        <button type="submit" class="form-submit-btn" id="submit-create-folder">Create Folder</button>
        <a href="/" class="form-cancel-link">Cancel</a>
    </form>
</main>

<%- include('partials/footer') %>
