<%- include('partials/head') %>

    <header class="home-header">
        <h1>
            <%= locals.authenticated ? 'Home' : 'Uploader' %>
        </h1>
        <h2>
            <% if (locals.authenticated) { %>
                <span class="session-info">
                    <i data-lucide="user-round" width="18" height="18" class="lucide-icon" style="margin-right: 6px;"></i>
                    Logged in as:&nbsp;<span class="session-user">
                        <%= locals.username %>
                    </span>
                </span>
                <% } else { %>
                    A modern platform to store and share your files
                    <% } %>
        </h2>
    </header>

    <main class="home-main">
        <% if (locals.authenticated) { %>
            <% if (folders.length===0) { %>
                <div class="no-folders-notice">
                    <div class="folder-icon-cont glow-border">
                        <i data-lucide="folder" width="36" height="36" class="lucide-icon" style="color: var(--highlight-text);"></i>
                    </div>
                    <p class="notice-heading">No folders yet!</p>
                    <p class="notice-subtext">Create your first folder to start hosting and sharing your files.</p>
                    <div class="action-links-cont">
                        <a href="/create-folder" class="create-folder-link" id="create-first-folder">
                            <i data-lucide="folder-plus" width="18" height="18" class="lucide-icon" style="margin-right: 6px;"></i>
                            New folder
                        </a>
                    </div>
                </div>
                <% } else { %>
                    <div class="all-folders-cont">
                        <% folders.forEach(folder=> { %>
                            <div class="folder-cont" id="folder-<%= folder.folderId %>">
                                <div class="folder-info">
                                    <div class="folder-icon-badge">
                                        <i data-lucide="folder" width="28" height="28" class="lucide-icon" style="color: var(--highlight-text);"></i>
                                    </div>
                                    <div>
                                        <p class="folder-name">
                                            <%= folder.name %>
                                        </p>
                                        <p class="folder-subtext">
                                            <%= folder.fileCount %> file<%= folder.fileCount !==1 ? 's' : '' %>
                                        </p>
                                    </div>
                                </div>
                                <% if (folder.description) { %>
                                    <p class="folder-desc">
                                        <%= folder.description %>
                                    </p>
                                    <% } %>
                                        <div
                                            class="folder-actions">
                                            <a href="/edit-folder/<%= folder.folderId %>" class="edit-folder-link"
                                                id="edit-folder-<%= folder.folderId %>">Edit</a>
                                            <a href="/folder/<%= folder.folderId %>" class="view-folder-link"
                                                id="view-folder-<%= folder.folderId %>">Open</a>
                                            <!-- FOLDER SHARING COMMENTED OUT
                                            <% if (folder.visibilityName==='public' ) { %>
                                                <button class="share-link-btn"
                                                    onclick="copyShareLink('/share/folder/<%= folder.folderId %>')"
                                                    id="share-folder-<%= folder.folderId %>" title="Copy share link">
                                                    <i data-lucide="share-2" width="14" height="14" class="lucide-icon"></i>
                                                    Share
                                                </button>
                                                <% } %>
                                            END FOLDER SHARING -->
                                                    <a href="/delete-folder/<%= folder.folderId %>"
                                                        class="delete-folder-link"
                                                        id="delete-folder-<%= folder.folderId %>">Delete</a>
                                        </div>
                            </div>
                            <% }) %>
                    </div>
                    <% } %>
                        <% } else { %>
                            <div class="login-notice">
                                <div class="folder-icon-cont glow-border">
                                    <i data-lucide="folder-open" width="36" height="36" class="lucide-icon" style="color: var(--highlight-text);"></i>
                                </div>
                                <p class="notice-heading">Host, view, and share your files</p>
                                <p class="notice-subtext">Uploader is a lightweight file hosting app that lets you
                                    create folders, upload files (images, PDFs, text & more), and access them from
                                    anywhere.</p>
                                <div class="action-links-cont">
                                    <a href="/signup" class="signup-link" id="cta-signup">
                                        <i data-lucide="user-plus" width="18" height="18" class="lucide-icon" style="margin-right: 6px;"></i>
                                        Signup
                                    </a>
                                    <a href="/login" class="login-link" id="cta-login">
                                        <i data-lucide="log-in" width="18" height="18" class="lucide-icon" style="margin-right: 6px;"></i>
                                        Login
                                    </a>
                                </div>
                            </div>
                            <% } %>
    </main>

    <% if (locals.authenticated) { %>
        <%- include('partials/footer') %>
    <% } %>