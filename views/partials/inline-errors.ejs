<% if (locals.errors && errors.length > 0) { %>
    <div class="errors-container">
        <% errors.forEach(error => { %>
            <div class="error-item">
                <i data-lucide="triangle-alert" width="16" height="16" class="lucide-icon"></i>
                <span><%= error.msg %></span>
            </div>
        <% }) %>
    </div>
<% } %>
