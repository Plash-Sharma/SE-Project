<footer>
    <div class="footer-links-cont">
        <a href="/" class="footer-btn" title="Home" id="footer-home">
            <i data-lucide="house" width="20" height="20" class="lucide-icon"></i>
        </a>
        <% if (locals.authenticated) { %>
            <a href="/create-folder" class="footer-btn footer-btn-wide" title="New Folder" id="footer-new-folder">
                <i data-lucide="folder-plus" width="20" height="20" class="lucide-icon"></i>
                <span class="footer-btn-label">New Folder</span>
            </a>
            <a href="/logout" class="footer-btn" title="Logout" id="footer-logout">
                <i data-lucide="log-out" width="20" height="20" class="lucide-icon"></i>
            </a>
            <% } else { %>
                <a href="/login" class="footer-btn" title="Login" id="footer-login">
                    <i data-lucide="log-in" width="20" height="20" class="lucide-icon"></i>
                </a>
                <a href="/signup" class="footer-btn" title="Signup" id="footer-signup">
                    <i data-lucide="user-plus" width="20" height="20" class="lucide-icon"></i>
                </a>
                <% } %>
                    <a href="/help" class="footer-btn" title="Help" id="footer-help">
                        <i data-lucide="circle-help" width="20" height="20" class="lucide-icon"></i>
                    </a>
    </div>
</footer>

<!-- Copy toast notification -->
<div class="copy-toast" id="copy-toast">
    <i data-lucide="check" width="16" height="16" class="lucide-icon"></i>
    <span id="copy-toast-msg">Link copied to clipboard!</span>
</div>

<script>
    function copyShareLink(path) {
        const fullUrl = window.location.origin + path;
        navigator.clipboard.writeText(fullUrl).then(function () {
            var toast = document.getElementById('copy-toast');
            document.getElementById('copy-toast-msg').textContent = 'Link copied to clipboard!';
            toast.classList.add('visible');
            setTimeout(function () { toast.classList.remove('visible'); }, 2500);
        }).catch(function () {
            // Fallback: show the URL in a prompt
            window.prompt('Copy this share link:', window.location.origin + path);
        });
    }
</script>
</body>

</html>