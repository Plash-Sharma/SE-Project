<%- include('partials/head') %>

<header class="home-header">
    <h1>Shared: <%= folder.name %></h1>
    <h2>by @<%= folder.ownerUsername %></h2>
</header>

<main class="home-main">
    <% if (files.length === 0) { %>
        <div class="no-files-notice">
            <div class="file-icon-cont glow-border">
                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--highlight-text)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                </svg>
            </div>
            <p class="notice-heading">No public files</p>
            <p class="notice-subtext">This folder has no public files to display.</p>
        </div>
    <% } else { %>
        <div class="all-files-cont">
            <% files.forEach(file => { %>
                <div class="file-cont shared-file" id="shared-file-<%= file.fileId %>">
                    <div class="file-info">
                        <div class="file-icon-badge">
                            <% if (file.mimeType && file.mimeType.startsWith('image/')) { %>
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--highlight-text)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                    <circle cx="8.5" cy="8.5" r="1.5"/>
                                    <polyline points="21 15 16 10 5 21"/>
                                </svg>
                            <% } else { %>
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--green-button-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                </svg>
                            <% } %>
                        </div>
                        <div>
                            <p class="file-name"><%= file.name %></p>
                            <p class="file-subtext"><%= (file.size / 1024).toFixed(1) %> KB</p>
                        </div>
                    </div>
                    <div class="file-actions">
                        <a href="/share/file/<%= file.fileId %>" class="view-file-link" id="view-shared-file-<%= file.fileId %>">View</a>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</main>

<%- include('partials/footer') %>
