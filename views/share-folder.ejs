<%- include('partials/head') %>

    <header class="home-header">
        <h1>Shared: <%= folder.name %>
        </h1>
        <h2>by @<%= folder.ownerUsername %>
        </h2>
    </header>

    <main class="home-main">
        <% if (files.length===0) { %>
            <div class="no-files-notice">
                <div class="file-icon-cont glow-border">
                    <i data-lucide="file-text" width="36" height="36" class="lucide-icon" style="color: var(--highlight-text);"></i>
                </div>
                <p class="notice-heading">No public files</p>
                <p class="notice-subtext">This folder has no public files to display.</p>
            </div>
            <% } else { %>
                <div class="all-files-cont">
                    <% files.forEach(file=> { %>
                        <div class="file-cont shared-file" id="shared-file-<%= file.fileId %>">
                            <div class="file-info">
                                <div class="file-icon-badge">
                                    <% if (file.mimeType && file.mimeType.startsWith('image/')) { %>
                                        <i data-lucide="image" width="28" height="28" class="lucide-icon" style="color: var(--highlight-text);"></i>
                                        <% } else { %>
                                            <i data-lucide="file" width="28" height="28" class="lucide-icon" style="color: var(--green-button-color);"></i>
                                            <% } %>
                                </div>
                                <div>
                                    <p class="file-name">
                                        <%= file.name %>
                                    </p>
                                    <p class="file-subtext">
                                        <%= (file.size / 1024).toFixed(1) %> KB
                                    </p>
                                </div>
                            </div>
                            <div class="file-actions shared-file-actions">
                                <a href="/share/file/<%= file.fileId %>" class="view-file-link"
                                    id="view-shared-file-<%= file.fileId %>">View</a>
                                <a href="/folder/<%= folder.folderId %>/download/<%= file.fileId %>"
                                    class="download-shared-link"
                                    id="download-shared-file-<%= file.fileId %>">Download</a>
                            </div>
                        </div>
                        <% }) %>
                </div>
                <% } %>
    </main>

    <%- include('partials/footer') %>