<%- include('partials/head') %>

    <header class="home-header">
        <h1>
            <%= file.name %>
        </h1>
        <h2>
            <%= file.folderName %> · <%= file.visibilityName %> · <%= (file.size / 1024).toFixed(1) %> KB
        </h2>
    </header>

    <main class="file-main">
        <% if (isImage) { %>
            <div class="file-image-cont">
                <a href="/uploads/<%= file.storagePath.split('/').pop() %>" target="_blank">
                    <img src="/uploads/<%= file.storagePath.split('/').pop() %>" alt="<%= file.name %>">
                </a>
            </div>
            <% } else { %>
                <div class="file-preview-cont">
                    <div class="file-type-badge">
                        <% if (file.mimeType==='application/pdf' ) { %>
                            <i data-lucide="file-text" width="48" height="48" class="lucide-icon" style="color: var(--error-text);"></i>
                            <% } else { %>
                                <i data-lucide="file" width="48" height="48" class="lucide-icon" style="color: var(--green-button-color);"></i>
                                <% } %>
                    </div>
                    <p class="file-original-name">
                        <%= file.originalName %>
                    </p>
                    <p class="file-meta">
                        <%= file.mimeType %>
                    </p>
                </div>
                <% } %>

                    <% if (file.description) { %>
                        <div class="file-description">
                            <p>
                                <%= file.description %>
                            </p>
                        </div>
                        <% } %>

                            <div class="file-detail-actions">
                                <a href="/uploads/<%= file.storagePath.split('/').pop() %>" target="_blank"
                                    class="open-btn" id="open-file">
                                    <i data-lucide="external-link" width="16" height="16" class="lucide-icon" style="margin-right: 6px;"></i>
                                    Open in Browser
                                </a>
                                <a href="/folder/<%= file.parentFolderId %>/download/<%= file.fileId %>"
                                    class="download-btn" id="download-file">
                                    <i data-lucide="download" width="16" height="16" class="lucide-icon" style="margin-right: 6px;"></i>
                                    Download
                                </a>
                                <% if (file.visibilityName==='public' ) { %>
                                    <button class="share-btn" onclick="copyShareLink('/share/file/<%= file.fileId %>')"
                                        id="share-file-detail">
                                        <i data-lucide="share-2" width="16" height="16" class="lucide-icon" style="margin-right: 6px;"></i>
                                        Copy Share Link
                                    </button>
                                    <% } %>
                                        <a href="/folder/<%= file.parentFolderId %>" class="back-btn"
                                            id="back-to-folder">
                                            <i data-lucide="arrow-left" width="16" height="16" class="lucide-icon" style="margin-right: 6px;"></i>
                                            Back to folder
                                        </a>
                            </div>
    </main>

    <%- include('partials/footer') %>