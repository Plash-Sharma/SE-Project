<%- include('partials/head') %>

    <header class="home-header">
        <h1>
            <%= folder.name %>
        </h1>
        <h2>
            <%= folder.description || 'No description' %>
        </h2>
    </header>

    <main class="home-main">
        <% if (files.length===0) { %>
            <div class="no-files-notice">
                <div class="file-icon-cont glow-border">
                        <i data-lucide="file-text" width="36" height="36" class="lucide-icon" style="color: var(--highlight-text);"></i>
                </div>
                <p class="notice-heading">No files yet!</p>
                <p class="notice-subtext">Upload your first file to this folder.</p>
                <div class="action-links-cont">
                    <a href="/folder/<%= folder.folderId %>/create-file" class="create-file-link"
                        id="create-first-file">
                        <i data-lucide="file-plus" width="18" height="18" class="lucide-icon" style="margin-right: 6px;"></i>
                        Upload file
                    </a>
                </div>
            </div>
            <% } else { %>
                <div class="folder-top-actions">
                    <a href="/folder/<%= folder.folderId %>/create-file" class="create-file-link top-action-btn"
                        id="upload-file-btn">
                        <i data-lucide="file-plus" width="16" height="16" class="lucide-icon" style="margin-right: 6px;"></i>
                        Upload file
                    </a>
                </div>
                <div class="all-files-cont">
                    <% files.forEach(file=> { %>
                        <div class="file-cont" id="file-<%= file.fileId %>">
                            <div class="file-info">
                                <div class="file-icon-badge">
                                    <% if (file.mimeType && file.mimeType.startsWith('image/')) { %>
                                        <i data-lucide="image" width="28" height="28" class="lucide-icon" style="color: var(--highlight-text);"></i>
                                        <% } else if (file.mimeType==='application/pdf' ) { %>
                                            <i data-lucide="file-text" width="28" height="28" class="lucide-icon" style="color: var(--error-text);"></i>
                                            <% } else { %>
                                                <i data-lucide="file" width="28" height="28" class="lucide-icon" style="color: var(--green-button-color);"></i>
                                                <% } %>
                                </div>
                                <div>
                                    <p class="file-name">
                                        <%= file.name %>
                                    </p>
                                    <p class="file-subtext">
                                        <%= file.visibilityName %> · <%= (file.size / 1024).toFixed(1) %> KB
                                    </p>
                                </div>
                            </div>
                            <div class="file-actions<%= file.visibilityName === 'public' ? ' has-share' : '' %>">
                                <a href="/folder/<%= folder.folderId %>/edit-file/<%= file.fileId %>"
                                    class="edit-file-link" id="edit-file-<%= file.fileId %>">Edit</a>
                                <a href="/folder/<%= folder.folderId %>/file/<%= file.fileId %>" class="view-file-link"
                                    id="view-file-<%= file.fileId %>">View</a>
                                <% if (file.visibilityName==='public' ) { %>
                                    <button class="share-link-btn"
                                        onclick="copyShareLink('/share/file/<%= file.fileId %>')"
                                        id="share-file-<%= file.fileId %>" title="Copy share link">
                                        <i data-lucide="share-2" width="14" height="14" class="lucide-icon" style="margin-right: 6px;"></i>
                                        Share
                                    </button>
                                    <% } %>
                                        <a href="/folder/<%= folder.folderId %>/delete-file/<%= file.fileId %>"
                                            class="delete-file-link" id="delete-file-<%= file.fileId %>">Delete</a>
                            </div>
                        </div>
                        <% }) %>
                </div>
                <% } %>
    </main>

    <%- include('partials/footer') %>