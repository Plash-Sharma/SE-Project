<%- include('partials/head') %>

<header class="home-header">
    <h1><%= folder.name %></h1>
    <h2><%= folder.description || 'No description' %> · <%= folder.visibilityName %></h2>
</header>

<main class="home-main">
    <% if (files.length === 0) { %>
        <div class="no-files-notice">
            <div class="file-icon-cont glow-border">
                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--highlight-text)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="12" y1="18" x2="12" y2="12"/>
                    <line x1="9" y1="15" x2="15" y2="15"/>
                </svg>
            </div>
            <p class="notice-heading">No files yet!</p>
            <p class="notice-subtext">Upload your first file to this folder.</p>
            <div class="action-links-cont">
                <a href="/folder/<%= folder.folderId %>/create-file" class="create-file-link" id="create-first-file">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                        <line x1="12" y1="18" x2="12" y2="12"/>
                        <line x1="9" y1="15" x2="15" y2="15"/>
                    </svg>
                    Upload file
                </a>
            </div>
        </div>
    <% } else { %>
        <div class="folder-top-actions">
            <a href="/folder/<%= folder.folderId %>/create-file" class="create-file-link top-action-btn" id="upload-file-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Upload file
            </a>
        </div>
        <div class="all-files-cont">
            <% files.forEach(file => { %>
                <div class="file-cont" id="file-<%= file.fileId %>">
                    <div class="file-info">
                        <div class="file-icon-badge">
                            <% if (file.mimeType && file.mimeType.startsWith('image/')) { %>
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--highlight-text)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                    <circle cx="8.5" cy="8.5" r="1.5"/>
                                    <polyline points="21 15 16 10 5 21"/>
                                </svg>
                            <% } else if (file.mimeType === 'application/pdf') { %>
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--error-text)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                    <line x1="16" y1="13" x2="8" y2="13"/>
                                    <line x1="16" y1="17" x2="8" y2="17"/>
                                </svg>
                            <% } else { %>
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--green-button-color)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                </svg>
                            <% } %>
                        </div>
                        <div>
                            <p class="file-name"><%= file.name %></p>
                            <p class="file-subtext"><%= file.visibilityName %> · <%= (file.size / 1024).toFixed(1) %> KB</p>
                        </div>
                    </div>
                    <div class="file-actions">
                        <a href="/folder/<%= folder.folderId %>/edit-file/<%= file.fileId %>" class="edit-file-link" id="edit-file-<%= file.fileId %>">Edit</a>
                        <a href="/folder/<%= folder.folderId %>/file/<%= file.fileId %>" class="view-file-link" id="view-file-<%= file.fileId %>">View</a>
                        <a href="/folder/<%= folder.folderId %>/delete-file/<%= file.fileId %>" class="delete-file-link" id="delete-file-<%= file.fileId %>">Delete</a>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</main>

<%- include('partials/footer') %>
