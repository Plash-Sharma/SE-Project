<%- include('partials/head') %>

<header class="home-header">
    <h1>Delete File</h1>
    <h2>This action cannot be undone</h2>
</header>

<main class="logout-main">
    <div class="confirm-container">
        <div class="confirm-icon danger-glow">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="var(--error-text)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"/>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                <line x1="10" y1="11" x2="10" y2="17"/>
                <line x1="14" y1="11" x2="14" y2="17"/>
            </svg>
        </div>
        <p class="confirm-heading">Delete "<%= file.name %>"?</p>
        <p class="confirm-text">This file will be permanently deleted from the server. This action cannot be undone.</p>
        <div class="confirm-actions">
            <a href="/folder/<%= file.parentFolderId %>" class="cancel-btn" id="cancel-delete-file">Cancel</a>
            <form action="/folder/<%= file.parentFolderId %>/delete-file/<%= file.fileId %>" method="POST" style="display:inline;">
                <button type="submit" class="danger-btn" id="confirm-delete-file">Delete</button>
            </form>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
