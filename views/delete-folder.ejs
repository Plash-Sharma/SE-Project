<%- include('partials/head') %>

<header class="home-header">
    <h1>Delete Folder</h1>
    <h2>This action cannot be undone</h2>
</header>

<main class="logout-main">
    <div class="confirm-container">
        <div class="confirm-icon danger-glow">
            <i data-lucide="folder-x" width="36" height="36" class="lucide-icon" style="color: var(--error-text);"></i>
        </div>
        <p class="confirm-heading">Delete "<%= folder.name %>"?</p>
        <p class="confirm-text">All files inside this folder will be permanently deleted. This cannot be undone.</p>
        <div class="confirm-actions">
            <a href="/" class="cancel-btn" id="cancel-delete-folder">Cancel</a>
            <form action="/delete-folder/<%= folder.folderId %>" method="POST" style="display:inline;">
                <button type="submit" class="danger-btn" id="confirm-delete-folder">Delete</button>
            </form>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
