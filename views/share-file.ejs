<%- include('partials/head') %>

    <header class="home-header">
        <h1>
            <%= file.name %>
        </h1>
        <h2>Shared file · <%= (file.size / 1024).toFixed(1) %> KB</h2>
    </header>

    <main class="file-main">
        <% if (isImage) { %>
            <div class="file-image-cont">
                <a href="/uploads/<%= file.storagePath.split('/').pop() %>" target="_blank">
                    <img src="/uploads/<%= file.storagePath.split('/').pop() %>" alt="<%= file.name %>">
                </a>
            </div>
            <% } else { %>
                <div class="file-preview-cont">
                    <div class="file-type-badge">
                        <% if (file.mimeType==='application/pdf' ) { %>
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24"
                                fill="none" stroke="var(--error-text)" stroke-width="1.5" stroke-linecap="round"
                                stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                <polyline points="14 2 14 8 20 8" />
                                <line x1="16" y1="13" x2="8" y2="13" />
                                <line x1="16" y1="17" x2="8" y2="17" />
                            </svg>
                            <% } else { %>
                                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24"
                                    fill="none" stroke="var(--green-button-color)" stroke-width="1.5"
                                    stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                    <polyline points="14 2 14 8 20 8" />
                                </svg>
                                <% } %>
                    </div>
                    <p class="file-original-name">
                        <%= file.originalName %>
                    </p>
                    <p class="file-meta">
                        <%= file.mimeType %>
                    </p>
                </div>
                <% } %>

                    <% if (file.description) { %>
                        <div class="file-description">
                            <p>
                                <%= file.description %>
                            </p>
                        </div>
                        <% } %>

                            <div class="file-detail-actions">
                                <a href="/uploads/<%= file.storagePath.split('/').pop() %>" target="_blank"
                                    class="open-btn" id="open-shared-file">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                                        <polyline points="15 3 21 3 21 9" />
                                        <line x1="10" y1="14" x2="21" y2="3" />
                                    </svg>
                                    Open in Browser
                                </a>
                                <a href="/folder/<%= file.parentFolderId %>/download/<%= file.fileId %>"
                                    class="download-btn" id="download-shared-file">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                        <polyline points="7 10 12 15 17 10" />
                                        <line x1="12" y1="15" x2="12" y2="3" />
                                    </svg>
                                    Download
                                </a>
                                <a href="/" class="back-btn" id="back-to-home">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                        <polyline points="9 22 9 12 15 12 15 22" />
                                    </svg>
                                    Go to Uploader
                                </a>
                            </div>
    </main>

    <%- include('partials/footer') %>